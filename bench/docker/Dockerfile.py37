# Era image Python 3.7 untuk SWE-Lite-20 (lihat manifest.json).
# Build: docker build -f bench/docker/Dockerfile.py37 -t minicode-swe:py37 bench/docker
FROM python:3.7-slim
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir "pytest==7.4"
WORKDIR /repo
