# Era image Python 3.6 untuk SWE-Lite-20 (lihat manifest.json).
# Build: docker build -f bench/docker/Dockerfile.py36 -t minicode-swe:py36 bench/docker
# CATATAN: snapshot apt image ini kedaluwarsa (Release expired) — lewati
# pemeriksaan valid-until (aman: pin digest image + pytest==7.0 eksplisit).
FROM python:3.6-slim
RUN apt-get -o Acquire::Check-Valid-Until=false update \
  && apt-get install -y --no-install-recommends git build-essential \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir "pytest==7.0"
WORKDIR /repo
